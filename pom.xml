<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.0.6</version>
        <relativePath/>
    </parent>

    <groupId>com.gjl</groupId>
    <artifactId>music-mode</artifactId>
    <version>${revision}</version>
    <packaging>pom</packaging>
    <name>Music Mode - Parent</name>

    <modules>
        <module>music-common</module>
        <module>music-auth</module>
        <module>music-editor</module>
        <module>music-playback</module>
    </modules>

    <properties>
        <revision>1.1.8</revision>
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <!-- 内部模块版本 -->
        <music-common.version>${revision}</music-common.version>

        <!-- 第三方版本（从 music-server 提取） -->
        <mybatis-starter.version>3.0.4</mybatis-starter.version>
        <jaudiotagger.version>3.0.1</jaudiotagger.version>
        <opencc4j.version>1.8.1</opencc4j.version>
        <juniversalchardet.version>2.4.0</juniversalchardet.version>
        <jtransforms.version>3.1</jtransforms.version>
        <lombok.version>1.18.36</lombok.version>
        <jjwt.version>0.12.6</jjwt.version>
        <pinyin4j.version>2.5.1</pinyin4j.version>
        <lucene.version>9.12.0</lucene.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- 内部模块 -->
            <dependency>
                <groupId>com.gjl</groupId>
                <artifactId>music-common</artifactId>
                <version>${music-common.version}</version>
            </dependency>
            <dependency>
                <groupId>com.gjl</groupId>
                <artifactId>music-auth</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.gjl</groupId>
                <artifactId>music-editor</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.gjl</groupId>
                <artifactId>music-playback</artifactId>
                <version>${revision}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <configuration>
                        <encoding>UTF-8</encoding>
                        <annotationProcessorPaths>
                            <path>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok</artifactId>
                                <version>${lombok.version}</version>
                            </path>
                        </annotationProcessorPaths>
                    </configuration>
                </plugin>

                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-resources-plugin</artifactId>
                    <configuration>
                        <encoding>UTF-8</encoding>
                    </configuration>
                </plugin>

                <!-- Spring Boot：只有应用模块引用，common 不引用 -->
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <executions>
                        <execution>
                            <goals>
                                <goal>repackage</goal>
                            </goals>
                        </execution>
                    </executions>
                    <configuration>
                        <excludes>
                            <exclude>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok</artifactId>
                            </exclude>
                        </excludes>
                    </configuration>
                </plugin>

                <!-- 测试执行 -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <configuration>
                        <argLine>-XX:+EnableDynamicAgentLoading</argLine>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
