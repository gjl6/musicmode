<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.gjl.music.auth.mapper.AuthRoleMapper">

    <resultMap id="baseMap" type="com.gjl.music.auth.model.AuthRole">
        <id     column="id"          property="id"/>
        <result column="role_name"   property="roleName"/>
        <result column="role_code"   property="roleCode"/>
        <result column="description" property="description"/>
        <result column="create_time" property="createTime"/>
    </resultMap>

    <select id="selectById" resultMap="baseMap">
        SELECT * FROM auth_role WHERE id = #{id}
    </select>

    <select id="selectByCode" resultMap="baseMap">
        SELECT * FROM auth_role WHERE role_code = #{roleCode}
    </select>

    <select id="selectByUserId" resultMap="baseMap">
        SELECT r.* FROM auth_role r
        INNER JOIN auth_user_role ur ON r.id = ur.role_id
        WHERE ur.user_id = #{userId}
    </select>

    <select id="selectAll" resultMap="baseMap">
        SELECT * FROM auth_role ORDER BY id
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO auth_role (role_name, role_code, description, create_time)
        VALUES (#{roleName}, #{roleCode}, #{description}, COALESCE(#{createTime}, CURRENT_TIMESTAMP))
    </insert>

    <insert id="insertUserRole">
        INSERT INTO auth_user_role (user_id, role_id) VALUES (#{userId}, #{roleId})
    </insert>

    <delete id="deleteUserRole">
        DELETE FROM auth_user_role WHERE user_id = #{userId} AND role_id = #{roleId}
    </delete>

    <delete id="deleteUserRoles">
        DELETE FROM auth_user_role WHERE user_id = #{userId}
    </delete>

    <update id="updateById">
        UPDATE auth_role
        SET role_name = #{roleName}, description = #{description}
        WHERE id = #{id}
    </update>

    <delete id="deleteById">
        DELETE FROM auth_role WHERE id = #{id}
    </delete>

</mapper>
