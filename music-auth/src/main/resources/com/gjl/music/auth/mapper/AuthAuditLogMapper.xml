<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.gjl.music.auth.mapper.AuthAuditLogMapper">

    <resultMap id="baseMap" type="com.gjl.music.auth.model.AuthAuditLog">
        <id     column="id"          property="id"/>
        <result column="operator_id" property="operatorId"/>
        <result column="action"      property="action"/>
        <result column="target_type" property="targetType"/>
        <result column="target_id"   property="targetId"/>
        <result column="detail"      property="detail"/>
        <result column="ip_address"  property="ipAddress"/>
        <result column="create_time" property="createTime"/>
    </resultMap>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO auth_audit_log (operator_id, action, target_type, target_id, detail, ip_address)
        VALUES (#{operatorId}, #{action}, #{targetType}, #{targetId}, #{detail}, #{ipAddress})
    </insert>

    <select id="selectByOperatorId" resultMap="baseMap">
        SELECT * FROM auth_audit_log
        WHERE operator_id = #{operatorId}
        ORDER BY create_time DESC
        LIMIT #{limit} OFFSET #{offset}
    </select>

    <select id="selectByTimeRange" resultMap="baseMap">
        SELECT * FROM auth_audit_log
        WHERE create_time BETWEEN #{startTime} AND #{endTime}
        ORDER BY create_time DESC
        LIMIT #{limit} OFFSET #{offset}
    </select>

    <select id="count" resultType="long">
        SELECT COUNT(*) FROM auth_audit_log
    </select>

</mapper>
