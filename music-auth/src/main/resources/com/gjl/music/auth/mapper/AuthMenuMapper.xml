<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.gjl.music.auth.mapper.AuthMenuMapper">

    <resultMap id="baseMap" type="com.gjl.music.auth.model.AuthMenu">
        <id     column="id"              property="id"/>
        <result column="parent_id"       property="parentId"/>
        <result column="route_name"      property="routeName"/>
        <result column="route_path"      property="routePath"/>
        <result column="component_key"   property="componentKey"/>
        <result column="permission_code" property="permissionCode"/>
        <result column="requires_admin"  property="requiresAdmin"/>
        <result column="sort_order"      property="sortOrder"/>
        <result column="is_visible"      property="isVisible"/>
        <result column="icon"            property="icon"/>
        <result column="create_time"     property="createTime"/>
    </resultMap>

    <select id="selectAllOrdered" resultMap="baseMap">
        SELECT * FROM auth_menu ORDER BY sort_order, id
    </select>

</mapper>
